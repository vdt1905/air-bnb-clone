{
  "name": "airbnb-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original desktop-only Airbnb listing page implementation",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspaces --if-present",
    "test:browser": "playwright test",
    "check": "npm run build && npm test && npm run test:browser",
    "preview": "node node_modules/vite/bin/vite.js preview --config client/vite.config.js --host 127.0.0.1 --port 5190 --strictPort client",
    "architecture": "node scripts/render-architecture.mjs",
    "package:submission": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-submission.ps1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1"
  }
}
